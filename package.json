{
  "name": "livescreen-painter",
  "version": "1.0.0",
  "description": "Draw on your live screen with a transparent overlay",
  "main": "dist/main/main.js",
  "scripts": {
    "build": "tsc",
    "start": "npm run build && env -u ELECTRON_RUN_AS_NODE electron .",
    "dev": "tsc && env -u ELECTRON_RUN_AS_NODE electron .",
    "pack:win": "npm run build && electron-builder --win",
    "pack:mac": "npm run build && electron-builder --mac",
    "pack:all": "npm run build && electron-builder --mac --win"
  },
  "dependencies": {
    "fabric": "^6.6.1"
  },
  "devDependencies": {
    "electron": "^32.3.3",
    "electron-builder": "^26.8.1",
    "typescript": "^5.6.0"
  },
  "build": {
    "appId": "com.livescreen.painter",
    "productName": "LiveScreen Painter",
    "files": [
      "dist/**/*",
      "src/renderer/**/*.html",
      "src/renderer/**/*.css",
      "node_modules/fabric/dist/index.js"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": ["x64"]
        }
      ],
      "icon": null
    },
    "nsis": {
      "oneClick": true,
      "allowToChangeInstallationDirectory": false,
      "installerIcon": null,
      "uninstallerIcon": null
    },
    "mac": {
      "target": "dmg",
      "category": "public.app-category.graphics-design"
    }
  }
}
